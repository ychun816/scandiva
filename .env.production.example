# Copy to .env.production on the SERVER (never commit the real file).
#   cp .env.production.example .env.production  &&  edit values
# Used by docker-compose.prod.yml.

# ---- Auth ----
# Generate a strong, unique secret. Must be >= 32 chars in production or the
# backend refuses to start. Example generator:  openssl rand -base64 48
JWT_SECRET=replace-with-openssl-rand-base64-48

# ---- CORS ----
# Your public origin. Requests from other origins are rejected.
CORS_ORIGIN=https://your-domain.example

# Public deployments should normally create accounts deliberately with
# scripts/create_admin.js and keep self-registration closed.
ALLOW_REGISTRATION=false

# ---- Cloudflare Tunnel ----
# Token from the Zero Trust dashboard (Networks → Tunnels → your tunnel → Docker).
# The tunnel's public hostname should route to the service URL  http://web:80
TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# ---- Optional: rate limit ceilings (defaults shown) ----
# AUTH_RATE_LIMIT_MAX=10
# ADMIN_RATE_LIMIT_MAX=30
